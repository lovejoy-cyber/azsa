# Copy this file to .env.local for local development, or set these as
# environment variables in your hosting provider (Vercel, Render, etc).

# Postgres connection string. For local dev, point at a local Postgres.
# For production, use a free-tier managed Postgres such as Neon or Supabase.
DATABASE_URL="postgresql://user:password@host:5432/azsa"

# Generate with: npx auth secret
# (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-real-secret"

# The public URL of your deployment. For local dev, leave as-is.
NEXTAUTH_URL="http://localhost:3000"
